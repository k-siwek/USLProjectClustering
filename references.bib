@book{gonzalez_digital_2018,
	address = {New York, NY},
	edition = {Fourth edition, global edition},
	title = {Digital image processing},
	isbn = {978-1-292-22304-9 978-1-292-22307-0},
	abstract = {For courses in Image Processing and Computer Vision. Introduce your students to image processing with the industry's most prized text For 40 years, Image Processinghas been the foundational text for the study of digital image processing. The book is suited for students at the college senior and first-year graduate level with prior background in mathematical analysis, vectors, matrices, probability, statistics, linear systems, and computer programming. As in all earlier editions, the focus of this edition of the book is on fundamentals. The4th Edition, which celebrates the book's 40th anniversary, is based on an extensive survey of faculty, students, and independent readers in 150 institutions from 30 countries. Their feedback led to expanded or new coverage of topics such as deep learning and deep neural networks, including convolutional neural nets, the scale-invariant feature transform (SIFT), maximally-stable extremal regions (MSERs), graph cuts, k-means clustering and superpixels, active contours (snakes and level sets), and exact histogram matching. Major improvements were made in reorganizing the material on image transforms into a more cohesive presentation, and in the discussion of spatial kernels and spatial filtering. Major revisions and additions were made to examples and homework exercises throughout the book. For the first time, we added MATLAB projects at the end of every chapter, and compiled support packages for students and faculty containing, solutions, image databases, and sample code},
	language = {eng},
	publisher = {Pearson},
	author = {Gonzalez, Rafael C. and Woods, Richard E.},
	year = {2018},
	annote = {Includes bibliographical references (pages 995-1007) and index},
	annote = {Introduction Digital Image Fundamentals Intensity Transformations and Spatial Filtering Filtering in the Frequency Domain Image Restoration and Reconstruction Color Image Processing Wavelet and Other Image Transforms Image Compression and Watermarking Morphological Image Processing Image Segmentation Feature Extraction Image Pattern Classification},
}


@misc{shyndali_perception_2026,
	title = {From {Perception} to {Pixels}: {Human}-{Derived} {Visually} {Distinct} {Colors} for {Improved} {Dominant} {Color} {Extraction}},
	copyright = {arXiv.org perpetual, non-exclusive license},
	shorttitle = {From {Perception} to {Pixels}},
	url = {https://arxiv.org/abs/2610.32473},
	doi = {10.48550/ARXIV.2610.32473},
	abstract = {Dominant color extraction is a fundamental task in computer vision, with applications in design, image retrieval, and content recommendation. However, conventional algorithms based on device-oriented color spaces (e.g., RGB) and fixed quantization often fail to capture how humans perceive color differences. In this study, we propose a human-perception-based framework for dominant color extraction, built on a novel Human Color Dictionary (HCD) derived from a perceptual experiment. Participants (n=110) were sequentially shown 120 colors and asked to identify those they perceived as unique. Based on their responses, we constructed a 120 by 120 co-occurrence matrix and applied a greedy selection algorithm to derive 64 perceptually distinct colors, forming the HCD. This dictionary was integrated into RGB color histogram and K-means color extraction algorithms by initializing centroids and mapping pixel values to their nearest perceptual color using the deltaE 00 distance. Evaluation on a dataset of 4,562 images paired with expert-designed palettes demonstrated that our method improves perceptual alignment, as measured by Earth Mover's Distance (EMD) and best-match distance. Our findings suggest no meaningful gender differences in the number of uniquely perceived colors, indicating that sex does not significantly influence color perception in this task. Another key finding is that highly saturated colors are perceived as the most distinguishable, whereas dark and deep colors tend to perceptually collapse and are less reliably differentiated. The results confirm that incorporating experimentally derived human color representations ensures the generated color clusters align more closely with human perception, thus improving the usability of color palette generation in practical applications.},
	urldate = {2026-11-24},
	publisher = {arXiv},
	author = {Shyndali, Uldana and Toleugaliyev, Nurdaulet and Zharykbayev, Kuat and Abildasheva, Zarina and Shamoi, Pakizar},
	month = oct,
	year = {2026},
	note = {Version Number: 1},
	keywords = {FOS: Computer and information sciences, Human-Computer Interaction (cs.HC), Computer Vision and Pattern Recognition (cs.CV)},
}

